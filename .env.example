# Local only. Bootstrap generates .env credentials; this template contains no real secrets.
WB_ENVIRONMENT=local
WB_AUTH_MODE=fixture
WB_AUTH_ISSUER=urn:sih:local-fixture
WB_AUTH_AUDIENCE=workbench-api
WB_DEPENDENCY_CHECKS=false
WB_TELEMETRY_ENABLED=false
WB_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
WB_TEMPORAL_ADDRESS=127.0.0.1:7233
WB_TEMPORAL_TASK_QUEUE=foundation
WB_S3_ENDPOINT=http://127.0.0.1:5000
POSTGRES_PASSWORD=
WB_DATABASE_URL=
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Generated by bootstrap; separate, non-owner runtime accounts. Never commit actual values.
APP_DATABASE_PASSWORD=
DELIVERY_DATABASE_PASSWORD=
RELAY_DATABASE_PASSWORD=
SCAN_DATABASE_PASSWORD=
WORKER_DATABASE_PASSWORD=
WB_APP_DATABASE_URL=
WB_DELIVERY_DATABASE_URL=
WB_RELAY_DATABASE_URL=
WB_SCAN_DATABASE_URL=
WB_WORKER_DATABASE_URL=
# Compose enables the persisted Phase 2–4 API. Standalone foundation mode remains available.
WB_DOMAIN_ENABLED=false
WB_S3_PUBLIC_ENDPOINT=http://127.0.0.1:5000
WB_MAX_UPLOAD_BYTES=26214400
WB_INSTITUTION_QUOTA_BYTES=524288000
WB_ACTOR_QUOTA_BYTES=262144000
WB_MAX_PENDING_UPLOADS=10
WB_UPLOAD_TTL_SECONDS=900
WB_MAX_PDF_PAGES=50
WB_MAX_VIDEO_SECONDS=3600
WB_SCANNER_MAX_SIGNATURE_AGE_HOURS=72
