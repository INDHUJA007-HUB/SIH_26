{
  "deployment_state": "REFERENCE_TEMPLATE_NOT_DEPLOYED",
  "substitution": "Replace QUARANTINE_BUCKET and EVIDENCE_BUCKET per environment. Provision separate cloud identities for each policy. The development emulator does not enforce these identities.",
  "api": {
    "Version": "2012-10-17",
    "Statement": [{
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::QUARANTINE_BUCKET/quarantine/*"
    }]
  },
  "delivery": {
    "Version": "2012-10-17",
    "Statement": [{
      "Effect": "Allow",
      "Action": ["s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::EVIDENCE_BUCKET/*"
    }]
  },
  "scanner": {
    "Version": "2012-10-17",
    "Statement": [
      {"Effect": "Allow", "Action": "s3:GetObjectVersion", "Resource": "arn:aws:s3:::QUARANTINE_BUCKET/quarantine/*"},
      {"Effect": "Allow", "Action": "s3:PutObject", "Resource": "arn:aws:s3:::EVIDENCE_BUCKET/*"}
    ]
  },
  "reconciliation": {
    "Version": "2012-10-17",
    "Statement": [
      {"Effect": "Allow", "Action": "s3:ListBucketVersions", "Resource": "arn:aws:s3:::EVIDENCE_BUCKET"},
      {"Effect": "Allow", "Action": "s3:GetObjectVersion", "Resource": ["arn:aws:s3:::EVIDENCE_BUCKET/*", "arn:aws:s3:::QUARANTINE_BUCKET/quarantine/*"]},
      {"Effect": "Allow", "Action": "s3:AbortMultipartUpload", "Resource": "arn:aws:s3:::QUARANTINE_BUCKET/quarantine/*"}
    ]
  },
  "bucket_transport_policy": {
    "Version": "2012-10-17",
    "Statement": [{
      "Sid": "DenyUnencryptedTransport",
      "Effect": "Deny", "Principal": "*", "Action": "s3:*",
      "Resource": ["arn:aws:s3:::EVIDENCE_BUCKET", "arn:aws:s3:::EVIDENCE_BUCKET/*"],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }]
  }
}
