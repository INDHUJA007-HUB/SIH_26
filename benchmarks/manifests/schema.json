{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbench evaluation packet manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "institution_group", "template_family", "split", "synthetic", "language", "files", "ground_truth_ref", "adjudication_ref"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 1},
    "institution_group": {"type": "string", "minLength": 1},
    "template_family": {"type": "string", "minLength": 1},
    "split": {"enum": ["development", "test", "safety-expansion"]},
    "synthetic": {"type": "boolean"},
    "language": {"type": "string", "minLength": 2},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["reference", "sha256", "provenance"], "properties": {"reference": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "provenance": {"type": "string"}}}},
    "ground_truth_ref": {"type": "string", "minLength": 1},
    "adjudication_ref": {"type": "string", "minLength": 1}
  }
}
